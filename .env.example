# Copy this file to .env. Select a provider in conf/app.yaml.
# Keep API keys only here; never place them in YAML or commit them.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional environment overrides for the selected provider and LLM settings.
# GBB_LLM_PROVIDER=google
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-sonnet-4-0
# GBB_LLM_TIMEOUT_MS=45000
# GBB_LLM_TEMPERATURE=0.1
# GBB_LLM_MAX_OUTPUT_TOKENS=1200
# GEMINI_TIMEOUT_MS=45000  # Backward-compatible Google timeout override.
GBB_DATABASE_PATH=data/gbb_terminal.duckdb
GBB_LOG_DIRECTORY=log
GBB_FRONTEND_DIRECTORY=app
GBB_REFRESH_INTERVAL_SECONDS=900
GBB_DATA_CONTACT=your-email@example.com
# Optional ignored local analyst-estimate fixture.
# GBB_ESTIMATE_FIXTURE_PATH=conf/estimates.json
